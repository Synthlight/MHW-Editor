<Window x:Class="MHW_Editor.Windows.ValueInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Height="190" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Name="lbl_message" Grid.Row="0" Margin="0,0,0,10" TextWrapping="Wrap" FontSize="14" Text="Enter value:"/>
        <TextBox Name="txt_value" Grid.Row="1" Margin="0,5,0,10" Height="30" FontSize="16" VerticalContentAlignment="Center" Padding="5,0,5,0"/>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="btn_ok" Width="90" Height="30" Margin="0,0,10,0" Content="OK" IsDefault="True" Click="Btn_ok_Click"/>
            <Button Name="btn_cancel" Width="90" Height="30" Content="Cancel" IsCancel="True" Click="Btn_cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
